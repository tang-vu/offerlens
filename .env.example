# Default mode is deterministic and requires no secrets.
AI_PROVIDER=demo

# Hosted OpenAI or an OpenAI-compatible endpoint. Secrets stay server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional GitHub token raises public API rate limits. Never exposed to the browser.
GITHUB_TOKEN=

# Optional PostgreSQL persistence for structured reports only. Raw documents are never stored.
DATABASE_URL=postgres://offerlens:offerlens@localhost:5432/offerlens
ANALYSIS_RETENTION_DAYS=30

# Optional deployment controls.
TRUST_PROXY=false
RATE_LIMIT_MAX=20
